---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n';
import { t } from '../i18n';
import '../styles/global.css';

export interface Props {
  lang: Lang;
  dir: 'ltr' | 'rtl';
  title: string;
  description?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { lang, dir, title, description, hideHeader, hideFooter } = Astro.props;
const siteTitle = t(lang, 'site_title');
const fullTitle = title === siteTitle ? siteTitle : `${title} - ${siteTitle}`;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {dir === 'rtl' && (
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap" rel="stylesheet" />
    )}

    <script is:inline>
      if (localStorage.getItem('color-theme') === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>

    <style is:global>
      /* Article content styles */
      .article-content {
        overflow-wrap: break-word;
        word-wrap: break-word;
      }
      .article-content pre {
        overflow-x: auto;
        max-width: 100%;
      }
      .article-content img,
      .article-content video,
      .article-content iframe {
        max-width: 100%;
        height: auto;
      }
      .article-content table {
        display: block;
        overflow-x: auto;
        max-width: 100%;
      }
      @media (max-width: 639px) {
        .article-content {
          font-size: 0.95rem;
          line-height: 1.65;
        }
        .article-content h1 { font-size: 1.5rem; }
        .article-content h2 { font-size: 1.25rem; }
        .article-content h3 { font-size: 1.125rem; }
      }
    </style>
  </head>
  <body class="min-h-screen">
    {!hideHeader && <Header lang={lang} dir={dir} />}
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer lang={lang} />}

    <!-- impeccable-live-start (kept for compatibility) -->
    <!-- impeccable-live-end -->
  </body>
</html>
