---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from './ContactForm.astro';

export interface Props {
  lang: Lang;
  dir: 'ltr' | 'rtl';
}

const { lang, dir } = Astro.props;
const isAr = lang === 'ar';

const authorData = await import(`../data/${lang}/author.js`);
const projectsData = await import(`../data/${lang}/projects.js`);
const experienceData = await import(`../data/${lang}/experience.js`);
const blogsData = await import(`../data/${lang}/blogs.js`);
const seminarsData = await import(`../data/${lang}/seminars.js`);

const author = authorData.default.author;
const honors = authorData.default.honors || [];
const voluntary = authorData.default.voluntary || [];
const projects = projectsData.default.projects || [];
const experience = experienceData.default.experience || [];
const blogs = blogsData.default.blogs || [];
const seminars = seminarsData.default.seminars || [];

const bondExtra = isAr
  ? ' يعمل في الإنتاج وعالج حوالي 1000 عميل محتمل.'
  : ' In production, around 1,000 leads processed.';

const timeline = [
  ...experience.map((item: any, index: number) => ({
    when: item.period,
    role: item.role,
    org: item.company,
    description: item.company === 'Bond Group' ? `${item.description}${bondExtra}` : item.description,
    past: index > 0,
  })),
  ...voluntary.map((item: any) => ({
    when: item.period,
    role: item.role,
    org: item.organization,
    description: item.description,
    past: true,
  })),
];

const copy = isAr
  ? {
      kicker: 'مهندس برمجيات متكامل',
      h1: 'الذكاء الاصطناعي يكتب الكود. وأنا أسلم أنظمة تصمد.',
      lead: 'أصمم منتجك وأبنيه وأنشره وأوسعه بنفسي، من قاعدة البيانات إلى الواجهة إلى الخادم الذي يعمل عليه. الذكاء الاصطناعي لا يعرف عملك ولا يتحمل مسؤولية النتيجة. أنا أتحملها.',
      talk: 'لنتحدث',
      resume: 'السيرة الذاتية',
      talkIntro: 'أخبرني بما تريد بناءه. تصلني الرسالة مباشرة.',
      allProjects: 'كل المشاريع ←',
      allPosts: 'كل المقالات ←',
      emptyBlogs: 'لا توجد مقالات هنا بعد. أعمل على تشكيل التدوينة القادمة.',
      frames: {
        what: 'ما الذي تحصل عليه',
        timeline: 'الخط الزمني',
        projects: 'المشاريع',
        honors: 'التكريمات',
        writing: 'الكتابة',
        talks: 'اللقاءات',
      },
      pillars: [
        { key: 'design', title: 'تصميم أنظمة أفضل', detail: 'Clean Architecture وDDD وCQRS، ليبقى النظام سهل التعديل.' },
        { key: 'quality', title: 'أخطاء أقل', detail: 'اختبارات حول الكود، بتغطية اختبارات وحدات تقارب 80% في Taager.' },
        { key: 'scale', title: 'قابلية التوسع', detail: 'خدمات على Docker وKubernetes، مع مراقبة عبر Datadog.' },
        { key: 'ui/ux', title: 'واجهة وتجربة استخدام جيدة', detail: 'تصميم في Figma، وبناء بـ React وNext.js.' },
        { key: 'delivery', title: 'تسليم سريع', detail: 'نظام CRM يعمل في الإنتاج، بناه فريق من شخصين في Bond Group.' },
      ],
    }
  : {
      kicker: 'Full-stack software engineer',
      h1: 'AI writes code. I deliver systems that hold up.',
      lead: 'I design, build, deploy and scale your product on my own, from the database to the interface to the server it runs on. AI does not know your business or own the result. I do.',
      talk: "Let's talk",
      resume: 'Resume',
      talkIntro: 'Tell me what you want to build. The message goes straight to me.',
      allProjects: 'all projects →',
      allPosts: 'all posts →',
      emptyBlogs: 'No posts here yet. I am still shaping the next write-up.',
      frames: {
        what: 'what you get',
        timeline: 'timeline',
        projects: 'projects',
        honors: 'honors',
        writing: 'writing',
        talks: 'talks',
      },
      pillars: [
        { key: 'design', title: 'Better system design', detail: 'Clean Architecture, DDD and CQRS, so the system stays easy to change.' },
        { key: 'quality', title: 'Fewer errors', detail: 'Tests around the code, with about 80% unit coverage at Taager.' },
        { key: 'scale', title: 'Scalable', detail: 'Services in Docker and Kubernetes, with monitoring in Datadog.' },
        { key: 'ui/ux', title: 'Good UI and UX', detail: 'Designed in Figma, built in React and Next.js.' },
        { key: 'delivery', title: 'Fast delivery', detail: 'A production CRM shipped by a two-person team at Bond Group.' },
      ],
    };
---

<BaseLayout lang={lang} dir={dir} title={isAr ? 'محمد سمير الصوالحي' : 'Muhammad Samir Assawalhy'} description={author.description}>
  <div slot="header" />
  <div slot="footer" />

  <div class="shell">
    <section class="section hero" style="padding-top:72px">
      <p class="label">{copy.kicker}</p>
      <h1>{copy.h1}</h1>
      <p class="muted">{copy.lead}</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
        <a class="btn btn--primary" href="#talk">{copy.talk}</a>
        <a class="btn" href={author.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn" href={author.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn" href="/resume.pdf">{copy.resume}</a>
      </div>
      <p class="faint mono" style="margin-top:16px;font-size:.78rem">{author.name}</p>
    </section>

    <section class="section">
      <div class="frame" data-title={copy.frames.what}>
        <ul class="rows">
          {copy.pillars.map((pillar: any) => (
            <li>
              <span class="rows__key">{pillar.key}</span>
              <div>
                <h3>{pillar.title}</h3>
                <p>{pillar.detail}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('experienceTitle', lang)}</h2>
      </div>
      <div class="frame" data-title={copy.frames.timeline}>
        <ol class="glyph-tl">
          {timeline.map((item: any) => (
            <li class={item.past ? 'is-past' : undefined}>
              <span class="glyph-tl__when">{item.when}</span>
              <span class="glyph-tl__what">
                {item.role} · {item.org}
                <span>{item.description}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('projectsTitle', lang)}</h2>
      </div>
      <div class="frame" data-title={copy.frames.projects}>
        <ul class="rows">
          {projects.map((project: any) => (
            <li>
              <span class="rows__key">{project.period?.match(/\d{4}/g)?.at(-1) ?? ''}</span>
              <div>
                <h3>
                  <a class="link" href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a>
                </h3>
                <p>{project.description}</p>
                <div class="tags">
                  {(project.tech || '').split(',').map((name: string) => <span>{name.trim()}</span>)}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <p style="margin-top:16px"><a class="link mono" href={`/${lang}/projects/`}>{copy.allProjects}</a></p>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('honorsTitle', lang)}</h2>
      </div>
      <div class="frame" data-title={copy.frames.honors}>
        <ul class="rows">
          {honors.map((honor: any) => (
            <li>
              <span class="rows__key">{honor.date}</span>
              <div>
                <h3>{honor.title}</h3>
                <p>{honor.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('blogsTitle', lang)}</h2>
      </div>
      <div class="frame" data-title={copy.frames.writing}>
        {blogs.length > 0 ? (
          <ul class="rows">
            {blogs.map((blog: any) => (
              <li>
                <span class="rows__key">{blog.date}</span>
                <div>
                  <h3>
                    <a class="link" href={blog.link}>{blog.title}</a>
                  </h3>
                  <p>{blog.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">{copy.emptyBlogs}</p>
        )}
      </div>
      <p style="margin-top:16px"><a class="link mono" href={`/${lang}/blogs/`}>{copy.allPosts}</a></p>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('seminarsTitle', lang)}</h2>
      </div>
      <div class="frame" data-title={copy.frames.talks}>
        <ul class="rows">
          {seminars.map((seminar: any) => (
            <li>
              <span class="rows__key">{seminar.date}</span>
              <div>
                <h3>
                  <a class="link" href={seminar.link} target="_blank" rel="noopener noreferrer">{seminar.title}</a>
                </h3>
                <p>{seminar.platform}: {seminar.summary}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="talk">
      <div class="section-head">
        <h2>{copy.talk}</h2>
        <p>{copy.talkIntro}</p>
      </div>
      <ContactForm lang={lang} email={author.email} />
    </section>
  </div>
</BaseLayout>

<style>
  .hero h1 {
    margin-top: 12px;
    max-width: 18em;
    color: var(--fg);
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero .muted {
    max-width: 36rem;
    margin-top: 16px;
  }
</style>
