---
import type { Lang } from '../i18n';
import { t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

export interface Props {
  lang: Lang;
  dir: 'ltr' | 'rtl';
}

const { lang, dir } = Astro.props;

// Import data files
const authorData = await import(`../data/${lang}/author.js`);
const projectsData = await import(`../data/${lang}/projects.js`);
const techData = await import(`../data/${lang}/tech.js`);
const experienceData = await import(`../data/${lang}/experience.js`);
const blogsData = await import(`../data/${lang}/blogs.js`);

const author = authorData.default.author;
const authorHonors = authorData.default.honors || [];
const authorVoluntary = authorData.default.voluntary || [];
const projects = projectsData.default.projects || [];
const techRows = techData.default;
const experience = experienceData.default.experience || [];
const blogs = blogsData.default.blogs || [];

const isAr = lang === 'ar';

// Pull timeline items
const honors = authorHonors;
const voluntary = authorVoluntary;
const acpc = honors[0];
const nasa = honors[1];
const ieee = honors[2];
const mentor = voluntary[0];
const zageng = voluntary[1];
const taager = experience[0];
const scicave = experience[1];

// Homepage copy
const heroKicker = isAr ? 'مهندس برمجيات متكامل' : 'Full-stack software engineer';
const heroTitle = isAr ? 'رحلة بناء بدأت بالفضول، وصارت مشاريع وتجارب ومجتمعات.' : 'From curiosity to projects, contests, and communities.';
const heroBody = isAr
  ? 'هذه ليست نسخة ويب من السيرة الذاتية. إنها خط زمني مختار لما بنيته وتعلمته وشاركت به، من أحدث المحطات إلى البدايات الأولى.'
  : 'A full-stack engineer, open source contributor, and three-time ACPC finalist who also happens to be a chess enthusiast and football player. This is a curated look at the work, the contests, and the communities that shaped that journey.';
const storyTitle = isAr ? 'الأحدث أولا، لكن كل محطة تشرح ما تغير.' : 'My story, chapter by chapter';
const storyIntro = isAr
  ? 'كل عنصر هنا يربط بين القرار والنتيجة: مشروع، تجربة عمل، مسابقة، أو لحظة تدريب ساعدتني على بناء طريقة تفكير أفضل.'
  : 'Each entry connects a decision to an outcome: a project, a role, a contest, or a mentoring moment that shaped how I think and build.';
const recentWriting = isAr ? 'أحدث ما أكتب' : 'Recent writing';
const writingIntro = isAr ? 'أضع هنا أحدث مقالتين فقط حتى تظل الصفحة قصة مختصرة، لا أرشيفا كاملا.' : 'Only the two newest posts live here, so the homepage stays a story rather than an archive.';
const emptyBlogs = isAr ? 'لا توجد مقالات هنا بعد. أعمل على تشكيل التدوينة القادمة.' : 'No posts here yet. I am still shaping the next write-up.';
const readPost = isAr ? 'اقرأ المقال' : 'Read post';
---

<BaseLayout lang={lang} dir={dir} title={isAr ? 'محمد سمير الصوالحي' : 'Muhammad Samir Assawalhy'} description={author.description}>
  <div slot="header" />
  <div slot="footer" />

  <div class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="hero__kicker">{heroKicker}</p>
        <h1 id="hero-title">{heroTitle}</h1>
        <p class="hero__body">{heroBody}</p>
        <div class="hero__actions" aria-label={t('contactLinks', lang)}>
          <a href={`mailto:${author.email}`} class="btn btn--primary">{t('startConversation', lang)}</a>
          <a href={author.github} target="_blank" rel="noopener noreferrer" class="btn">GitHub</a>
          <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="btn">LinkedIn</a>
        </div>
      </div>
      <aside class="hero__panel" aria-label={t('shortProfile', lang)}>
        <div class="hero__panel-inner">
          <div class="hero__portrait" data-tilt>
            <div class="hero__portrait-inner">
              <img src="/images/avatar-full.webp" alt={author.name} width="1024" height="1536" loading="lazy" />
            </div>
          </div>
          <p class="hero__name">{author.name}</p>
          <p class="hero__desc">{author.description}</p>
          <div class="hero__tech" aria-label={t('whatIWorkWith', lang)}>
            <p class="hero__tech-label">{t('whatIWorkWith', lang)}</p>
            <div class="hero__tech-list">
              {techRows.row1?.slice(0, 7).map((t: any) => <span>{t.name}</span>)}
              {techRows.row2?.slice(0, 4).map((t: any) => <span>{t.name}</span>)}
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section class="timeline-wrap" aria-labelledby="timeline-heading">
      <div class="timeline-intro">
        <h2 id="timeline-heading">{storyTitle}</h2>
        <p>{storyIntro}</p>
      </div>
      <div class="timeline" aria-label={isAr ? 'خط زمني مختار للخبرات والمشاريع والتكريمات' : 'Curated timeline of experience, projects, and honors'}>
        {taager && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{taager.period}</span>
              <strong>{t('experienceTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{taager.role} &middot; {taager.company}</h3>
              <p class="tl-entry__subtitle">{taager.country}</p>
              <p>{isAr
                ? 'في Taager، صممت ميكروسيرفيسات تتواصل عبر Apache Pulsar، وعملت مع Node.js وSpring Boot Kotlin على قواعد بيانات SQL (PostgreSQL) وNoSQL (MongoDB). طبقت Clean Architecture وDDD وCQRS، وحققت تغطية اختبارات ~80% باستخدام Testcontainers وMockK. واستخدمت feature flags للنشر التدريجي وتجارب A/B، مع خبرة في ArgoCD وKubernetes وDatadog.'
                : 'At Taager, I designed microservices communicating via Apache Pulsar, worked with Node.js and Spring Boot Kotlin across both SQL (PostgreSQL) and NoSQL (MongoDB) databases, applied Clean Architecture / DDD / CQRS, achieved ~80% test coverage with Testcontainers and MockK, leveraged feature flags for gradual rollout and A/B experimentation, and gained exposure to ArgoCD, Kubernetes, and Datadog.'
              }</p>
              <div class="tl-tags">
                {taager.technologies?.map((tech: string) => <span>{tech}</span>)}
              </div>
            </div>
          </article>
        )}

        {nasa && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{nasa.date}</span>
              <strong>{t('honorsTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{nasa.title}</h3>
              <p class="tl-entry__subtitle">{nasa.institution}</p>
              <p>{isAr
                ? 'مع فريق Pyroguardians، كان التحدي هو تحويل فكرة سريعة إلى مشروع يمكن عرضه بثقة. المركز الثالث والترشيح العالمي لم يكونا مجرد نتيجة، بل دليل على قدرة الفريق على تضييق نطاق الفكرة وبنائها تحت وقت محدود.'
                : 'With team Pyroguardians, the challenge was turning a fast idea into something presentable and credible. Third place and a global nomination were not just results. They were proof that the team could narrow the idea and build under real time pressure.'
              }</p>
            </div>
          </article>
        )}

        {ieee && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{ieee.date}</span>
              <strong>{t('honorsTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{ieee.title}</h3>
              <p class="tl-entry__subtitle">{ieee.institution}</p>
              <p>{isAr
                ? 'IEEEXtreme كان اختبارا مختلفا: ساعات طويلة، مسائل كثيرة، وقرارات مستمرة بين السرعة والدقة. الوصول إلى أفضل 15 فريقا في مصر من بين 198 فريقا جعل التجربة علامة واضحة على الانضباط الفني.'
                : 'IEEEXtreme was a different kind of test: long hours, many problems, and constant decisions between speed and accuracy. Reaching the top 15 in Egypt out of 198 teams made the experience a clear marker of technical discipline.'
              }</p>
            </div>
          </article>
        )}

        {scicave && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{scicave.period}</span>
              <strong>{t('experienceTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{scicave.role} &middot; {scicave.company}</h3>
              <p class="tl-entry__subtitle">{scicave.country}</p>
              <p>{isAr
                ? 'في SciCave عملت على تطبيقات ويب حقيقية، حيث لا يكفي أن تعمل الواجهة في المتصفح فقط. شملت التجربة React وNext.js وCypress وDocker وAWS، وربطت بين بناء الواجهة، الاختبار، جمع المتطلبات، وإدارة النشر.'
                : 'At SciCave, I worked on real web applications where a screen working locally was only the beginning. The role connected React, Next.js, Cypress, Docker, and AWS with requirements work, UI decisions, testing, and deployment.'
              }</p>
              <div class="tl-tags">
                {scicave.technologies?.map((tech: string) => <span>{tech}</span>)}
              </div>
            </div>
          </article>
        )}

        {acpc && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{acpc.date}</span>
              <strong>{t('honorsTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{acpc.title}</h3>
              <p class="tl-entry__subtitle">{acpc.institution}</p>
              <p>{isAr
                ? 'ثلاث مرات متتالية في نهائيات ACPC جعلت البرمجة التنافسية أكثر من نشاط جانبي. كانت تدريبا طويل النفس على قراءة المسائل تحت الضغط، اختيار الخوارزمية المناسبة، وشرح الفكرة للفريق بسرعة ووضوح.'
                : 'Qualifying for the ACPC finals three times made competitive programming more than a side activity. It became long-form training in reading under pressure, choosing the right algorithm, and explaining an idea to a team quickly and clearly.'
              }</p>
            </div>
          </article>
        )}

        {mentor && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>2022-2024</span>
              <strong>{t('voluntaryTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{mentor.role}</h3>
              <p class="tl-entry__subtitle">{mentor.organization} &middot; {mentor.period}</p>
              <p>{isAr
                ? 'كانت هذه المحطة عن تحويل الخبرة إلى أثر عند الآخرين. في مجتمع ICPC بجامعة الزقازيق، لم يكن دوري مجرد شرح خوارزميات، بل مساعدة الفرق على بناء طريقة تفكير للمسابقات، وكتابة مسائل، وتحويل التدريب الأسبوعي إلى عادة مستمرة.'
                : 'This chapter was about turning experience into leverage for other people. In the ICPC Community at Zagazig University, the work was not just explaining algorithms. It was helping teams build contest instincts, writing problems, and making weekly practice feel like a repeatable system.'
              }</p>
            </div>
          </article>
        )}

        {zageng && (
          <article class="tl-entry reveal">
            <div class="tl-entry__meta">
              <span>{zageng.period}</span>
              <strong>{t('voluntaryTitle', lang)}</strong>
            </div>
            <div class="tl-entry__body">
              <h3>{zageng.role}</h3>
              <p class="tl-entry__subtitle">{zageng.organization}</p>
              <p>{isAr
                ? 'في ZagEng، أصبحت الأتمتة طريقة لتقليل العمل المتكرر لا مجرد تجربة تقنية. قدت لجنة تقنية المعلومات لبناء أكثر من 13 بوت تليجرام ولوحة تحكم Django، وربطناها بتدفقات Make.com لخدمة الطلاب بسرعة أكبر.'
                : 'At ZagEng, automation became a way to remove repeated work, not just a technical experiment. I led the IT committee in building 13+ Telegram bots and a Django dashboard, then connected them with Make.com flows to serve students faster.'
              }</p>
            </div>
          </article>
        )}
      </div>
    </section>

    <section class="writing" aria-labelledby="writing-heading">
      <div class="writing__header">
        <h2 id="writing-heading">{recentWriting}</h2>
        <p>{writingIntro}</p>
      </div>
      {blogs.length > 0 ? (
        <div class="writing__list">
          {blogs.slice(0, 2).map((blog: any) => (
            <article class="writing__card reveal">
              <p class="writing__date">{blog.date}</p>
              <h3><a href={blog.link}>{blog.title}</a></h3>
              <p class="writing__summary">{blog.summary}</p>
              <a href={blog.link} class="writing__link">{readPost}</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="writing__empty" role="status">
          <p>{emptyBlogs}</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style is:global>
  .page-shell {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(2rem, 4vw, 4.5rem) clamp(4rem, 8vw, 7rem);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    min-height: min(720px, calc(100vh - 7rem));
    padding-block: clamp(2rem, 7vw, 7rem);
    overflow-x: clip;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -200px 0;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 45% at 25% 30%, rgba(2, 132, 199, 0.06), transparent 60%);
  }

  html.dark .hero::before {
    background: radial-gradient(ellipse 50% 45% at 25% 30%, rgba(14, 165, 233, 0.07), transparent 60%);
  }

  .hero__kicker {
    margin: 0 0 0.75rem;
    color: #0284c7;
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  html.dark .hero__kicker {
    color: #38bdf8;
  }

  .hero h1 {
    max-width: 14ch;
    margin: 0;
    color: #171717;
    font-size: clamp(2.5rem, 7vw, 5.75rem);
    line-height: 0.96;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  html.dark .hero h1 {
    color: #fafafa;
  }

  .hero__body {
    max-width: 62ch;
    margin: 1.5rem 0 0;
    color: #404040;
    font-size: clamp(1.08rem, 1.6vw, 1.35rem);
    line-height: 1.75;
  }

  html.dark .hero__body {
    color: #d4d4d4;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    color: #262626;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), border-color 180ms ease, color 180ms ease, background 180ms ease;
  }

  html.dark .btn {
    border-color: #404040;
    color: #f5f5f5;
  }

  .btn:hover,
  .btn:focus-visible {
    border-color: #0284c7;
    color: #0284c7;
    transform: translateY(-2px);
    outline: none;
  }

  .btn--primary {
    border-color: #0284c7;
    background: #0284c7;
    color: #fff;
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    background: #0369a1;
    color: #fff;
  }

  .hero__panel {
    border: 1px solid #d4d4d4;
    border-radius: 0.75rem;
    background: #fff;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: 0 24px 70px rgba(2, 8, 23, 0.12);
  }

  html.dark .hero__panel {
    border-color: #404040;
    background: #1a1a1a;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.35);
  }

  .hero__panel-inner {
    display: grid;
    gap: 0.75rem;
  }

  .hero__portrait {
    perspective: 1000px;
    width: 100%;
    margin-bottom: 0.75rem;
  }
  .hero__portrait-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform 200ms ease-out;
    will-change: transform;
    box-shadow: 0 12px 40px rgba(2, 132, 199, 0.15);
  }
  html.dark .hero__portrait-inner {
    box-shadow: 0 12px 40px rgba(2, 132, 199, 0.08);
  }
  .hero__portrait-inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    display: block;
  }
  .hero__portrait-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero__name {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .hero__desc {
    margin: 0;
    color: #525252;
    line-height: 1.7;
  }

  html.dark .hero__desc {
    color: #d4d4d4;
  }

  .hero__tech {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
  }

  html.dark .hero__tech {
    border-top-color: #333;
  }

  .hero__tech-label {
    margin: 0 0 0.6rem;
    color: #737373;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  html.dark .hero__tech-label {
    color: #a3a3a3;
  }

  .hero__tech-list,
  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .hero__tech-list span,
  .tl-tags span {
    border: 1px solid #d4d4d4;
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    color: #404040;
    font-size: 0.82rem;
    font-weight: 600;
  }

  html.dark .hero__tech-list span,
  html.dark .tl-tags span {
    border-color: #404040;
    color: #d4d4d4;
  }

  .timeline-wrap {
    margin-block: clamp(2rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }

  .timeline-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .timeline-intro h2 {
    max-width: 18ch;
    margin: 0;
    color: #171717;
    font-size: clamp(2.5rem, 7vw, 5.75rem);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  html.dark .timeline-intro h2 {
    color: #fafafa;
  }

  .timeline-intro p {
    max-width: 62ch;
    color: #525252;
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 0;
  }

  html.dark .timeline-intro p {
    color: #c7c7c7;
  }

  .timeline {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .timeline::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: clamp(7.4rem, 18vw, 13rem);
    width: 2px;
    background: linear-gradient(to bottom, transparent, #0284c7 6%, #3b82f6 20%, #737373 54%, transparent);
    border-radius: 1px;
  }

  html.dark .timeline::before {
    background: linear-gradient(to bottom, transparent, #0ea5e9 6%, #38bdf8 20%, #525252 54%, transparent);
  }

  .tl-entry {
    position: relative;
    display: grid;
    grid-template-columns: clamp(7rem, 18vw, 12rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
  }

  .tl-entry::before {
    content: "";
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: calc(clamp(7.4rem, 18vw, 13rem) - 0.46rem);
    width: 0.9rem;
    height: 0.9rem;
    border: 2.5px solid #0284c7;
    border-radius: 999px;
    background: #fff;
    z-index: 1;
    box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.15);
  }

  html.dark .tl-entry::before {
    background: #121212;
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.15);
  }

  .tl-entry__meta {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 0.35rem;
    padding-top: 0.35rem;
    color: #737373;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .tl-entry__meta strong {
    color: #262626;
  }

  html.dark .tl-entry__meta strong {
    color: #f5f5f5;
  }

  .tl-entry__body {
    min-width: 0;
    padding: clamp(1.1rem, 3vw, 2rem);
    border: 1px solid #e5e5e5;
    border-radius: 0.75rem;
    background: #fff;
  }

  html.dark .tl-entry__body {
    border-color: #333;
    background: #1a1a1a;
  }

  .tl-entry__body h3 {
    margin: 0;
    color: #171717;
    font-size: clamp(1.45rem, 3vw, 2.45rem);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  html.dark .tl-entry__body h3 {
    color: #fafafa;
  }

  .tl-entry__subtitle {
    margin: 0.7rem 0 1rem;
    color: #0284c7;
    font-weight: 700;
  }

  .tl-entry__body p:not(.tl-entry__subtitle) {
    color: #404040;
    font-size: 1rem;
    line-height: 1.78;
  }

  html.dark .tl-entry__body p:not(.tl-entry__subtitle) {
    color: #d4d4d4;
  }

  .tl-tags {
    margin-block: 1.1rem;
  }

  .writing {
