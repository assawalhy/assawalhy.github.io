  .reveal {
    transform: translateY(24px);
    transition: transform 640ms cubic-bezier(0.22, 1, 0.36, 1), opacity 640ms cubic-bezier(0.22, 1, 0.36, 1), filter 640ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .js .reveal {
    opacity: 0.001;
    filter: blur(4px);
  }

  .js .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

