---
import type { Lang } from '../i18n';
import { t } from '../i18n';

export interface Props {
  lang: Lang;
  dir: 'ltr' | 'rtl';
  author?: { name?: string; short_name?: string };
}

const { lang, author } = Astro.props;
const currentPath = Astro.url.pathname;

const menuItems: Record<Lang, Array<{ label: string; href: string }>> = {
  en: [
    { label: 'Projects', href: '/en/projects/' },
    { label: 'Seminars', href: '/en/seminars/' },
    { label: 'Blog', href: '/en/blogs/' },
    { label: 'Contact', href: '/en/contact/' },
  ],
  ar: [
    { label: 'المشاريع', href: '/ar/projects/' },
    { label: 'اللقاءات', href: '/ar/seminars/' },
    { label: 'المدونة', href: '/ar/blogs/' },
    { label: 'تواصل', href: '/ar/contact/' },
  ],
};

const otherLang: Lang = lang === 'en' ? 'ar' : 'en';
const translatedPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

const displayName = author?.short_name || author?.name || 'Assawalhy';
const resumeLabel = lang === 'ar' ? 'السيرة الذاتية' : 'Resume';
const themeLabel = lang === 'ar' ? 'تبديل المظهر' : 'Toggle color theme';
const navLabel = lang === 'ar' ? 'التنقل الرئيسي' : 'Main navigation';
---

<header class="site-header">
  <div class="shell site-header__row">
    <a class="site-home" href={`/${lang}/`}>
      <img src="/favicon-32x32.png" alt="" width="20" height="20" />
      {displayName}
    </a>
    <nav class="site-nav" aria-label={navLabel}>
      {menuItems[lang].map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href.replace(/\/$/, ''));
        return (
          <a href={item.href} aria-current={isActive ? 'page' : undefined}>{item.label}</a>
        );
      })}
    </nav>
    <div class="site-tools">
      <a class="mono resume-link" href="/resume.pdf" target="_blank" rel="noopener">{resumeLabel}</a>
      <a class="mono lang-switch" href={translatedPath} hreflang={otherLang} lang={otherLang}>{otherLang}</a>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label={themeLabel}>
        <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.75 15.25A9.75 9.75 0 0 1 8.75 2.25 9.75 9.75 0 1 0 21.75 15.25Z"/>
        </svg>
        <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px dashed var(--line);
    background: var(--bg);
  }

  .site-header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 24px;
    row-gap: 8px;
    min-height: 56px;
  }

  .site-home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }

  .site-home img {
    display: block;
    width: 20px;
    height: 20px;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    font-size: 0.85rem;
  }

  .site-nav a {
    color: var(--muted);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 0.15s;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--fg);
  }

  .site-tools {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-inline-start: auto;
  }

  .resume-link,
  .lang-switch {
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .resume-link:hover,
  .lang-switch:hover {
    color: var(--fg);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--fg);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  .theme-icon-sun {
    display: none;
  }

  :global(html.dark) .theme-icon-moon {
    display: none;
  }

  :global(html.dark) .theme-icon-sun {
    display: block;
  }

  .site-home:focus-visible,
  .site-nav a:focus-visible,
  .resume-link:focus-visible,
  .lang-switch:focus-visible,
  .theme-toggle:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .site-tools {
      order: 1;
    }

    .site-nav {
      order: 2;
      flex-basis: 100%;
    }
  }
</style>

<script>
  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
  });
</script>
