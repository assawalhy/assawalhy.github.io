---
import type { Lang } from '../i18n';

export interface Props {
  lang: Lang;
  author?: { name?: string; github?: string };
}

const { lang, author } = Astro.props;
const year = new Date().getFullYear();
const name = author?.name || 'Muhammad Samir Assawalhy';
const github = author?.github || 'https://github.com/assawalhy';
---

<footer class="site-footer mono">
  <div class="shell">
    <div class="site-footer__inner">
      <p>&copy; {year} {name}</p>
      <p>
        {lang === 'ar' ? 'بُني باستخدام' : 'Built with'}{' '}
        <a href="https://astro.build/" target="_blank" rel="noopener" class="link">Astro</a>.{' '}
        {lang === 'ar' ? 'ألقِ نظرة على' : 'Take a look at my'}{' '}
        <a href={github} target="_blank" rel="noopener" class="link">GitHub</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px dashed var(--line);
    padding-block: 32px;
    font-size: 0.78rem;
    color: var(--faint);
  }

  .site-footer__inner {
    display: grid;
    gap: 4px;
    text-align: start;
  }

  .site-footer p {
    margin: 0;
  }
</style>
