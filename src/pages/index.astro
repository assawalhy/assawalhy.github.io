---
// Root redirect to default locale
const lang = 'en';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Muhammad Samir Assawalhy</title>
  <noscript><meta http-equiv="refresh" content={`0;url=/${lang}/`} /></noscript>
  <script defer src="https://datalook.app/s.js" data-site="b261dd5f-03e2-46d7-a607-1c52376322db"></script>
  <script is:inline>
    (function() {
      var preferred = navigator.language || navigator.languages?.[0] || '';
      var lang = preferred.startsWith('ar') ? 'ar' : 'en';
      window.location.replace('/' + lang + '/');
    })();
  </script>
</head>
<body>
  <p><a href={`/${lang}/`}>Muhammad Samir Assawalhy</a></p>
</body>
</html>
