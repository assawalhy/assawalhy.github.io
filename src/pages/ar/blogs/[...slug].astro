---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Lang } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog-ar');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang: Lang = 'ar';
const dir = 'rtl';
const { title, date, tags, description } = post.data;
const formattedDate = date.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
const isoDate = date.toISOString().slice(0, 10);
---

<BaseLayout {lang} {dir} {title} description={description}>
  <div class="shell">
    <header class="page-head">
      <p class="label"><time datetime={isoDate}>{formattedDate}</time></p>
      <h1>{title}</h1>
      {description && <p class="muted">{description}</p>}
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.filter((t) => t).map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )}
    </header>

    <article class="article-content prose-lite">
      <Content />
    </article>

    <p style="margin-top:48px">
      <a class="link mono" href="/ar/blogs/">كل المقالات ←</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head h1 {
    font-size: 1.6rem;
    font-weight: 500;
    text-transform: none;
  }

  :global(.prose-lite) {
    margin-top: 32px;
  }

  :global(.prose-lite h2) {
    font-size: 1.15rem;
    font-weight: 500;
    margin-top: 2em;
  }

  :global(.prose-lite p) {
    margin-top: 1em;
  }

  :global(.prose-lite a) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  :global(.prose-lite code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    border: 1px dashed var(--line);
    padding: 0 4px;
  }

  :global(.prose-lite pre) {
    direction: ltr;
    border: 1px dashed var(--line);
    padding: 16px;
    overflow-x: auto;
    margin-top: 1em;
  }

  :global(.prose-lite pre code) {
    border: 0;
    padding: 0;
  }

  :global(.prose-lite ul),
  :global(.prose-lite ol) {
    padding-inline-start: 1.25rem;
    list-style: revert;
    margin-top: 1em;
  }

  :global(.prose-lite blockquote) {
    border-inline-start: 2px solid var(--line);
    padding-inline-start: 12px;
    color: var(--muted);
    margin-top: 1em;
  }
</style>
