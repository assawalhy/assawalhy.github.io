---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import blogsData from '../../../data/ar/blogs.js';
import type { Lang } from '../../../i18n';

const lang: Lang = 'ar';
const dir = 'rtl';
const title = 'المدونة';
const description = 'مقالات وكتابات محمد سمير الصوالحي';
const { blogs } = blogsData;
---

<BaseLayout {lang} {dir} {title} {description}>
  <div class="w-full md:w-3/4 lg:w-1/2 mx-auto px-4 py-12">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-8 sm:mb-12 break-words text-[#262626] dark:text-[#f5f5f5]">{title}</h1>

    <div class="space-y-12 max-w-3xl mx-auto">
      {blogs.length === 0 && (
        <p class="text-[#525252] dark:text-[#a3a3a3]">لا توجد مقالات هنا بعد. أعمل على تشكيل التدوينة القادمة.</p>
      )}
      {blogs.map((entry) => (
        <div class="group">
          <p class="text-[#525252] dark:text-[#a3a3a3] text-sm mb-2">{entry.date}</p>
          <a href={entry.link} class="block" target="_blank">
            <h3 class="inline-flex items-center text-xl font-medium text-[#0284c7] dark:text-[#0ea5e9] hover:text-[#262626] dark:hover:text-[#f5f5f5] transition-colors duration-200 mb-3">
              {entry.title}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 opacity-70 group-hover:opacity-100 transition-opacity duration-200">
                <path d="M7 17l9.2-9.2M17 17V7H7"/>
              </svg>
            </h3>
          </a>
          <p class="text-[#525252] dark:text-[#a3a3a3] mb-4">{entry.summary}</p>
          {entry.tags && entry.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {entry.tags.filter(t => t).map((tag) => (
                <span class="px-2 py-1 text-xs bg-white dark:bg-[#1a1a1a] text-[#525252] dark:text-[#a3a3a3] border border-[#d4d4d4] dark:border-[#404040] rounded-md transition-all duration-300">{tag}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
