---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import blogsData from '../../../data/ar/blogs.js';
import type { Lang } from '../../../i18n';

const lang: Lang = 'ar';
const dir = 'rtl';
const title = 'المدونة';
const description = 'مقالات وكتابات محمد سمير الصوالحي';
const { blogs } = blogsData;
---

<BaseLayout {lang} {dir} {title} {description}>
  <div class="shell">
    <header class="page-head">
      <h1>{title}</h1>
      <p>ملاحظات عن المسابقات والأدوات وما تعلمته أثناء بنائها.</p>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="frame" data-title="المقالات">
        {blogs.length === 0 && (
          <p class="muted">لا توجد مقالات هنا بعد. أعمل على تشكيل التدوينة القادمة.</p>
        )}
        {blogs.length > 0 && (
          <ul class="rows">
            {blogs.map((entry) => (
              <li>
                <span class="rows__key">{entry.date}</span>
                <div>
                  <h3>
                    <a href={entry.link} class="link" target="_blank" rel="noopener noreferrer">{entry.title}</a>
                  </h3>
                  <p>{entry.summary}</p>
                  {entry.tags && entry.tags.length > 0 && (
                    <div class="tags">
                      {entry.tags.filter((t) => t).map((tag) => (
                        <span>{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
