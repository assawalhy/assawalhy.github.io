---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import projectsData from '../../../data/ar/projects.js';

const { projects } = projectsData;
---

<BaseLayout lang="ar" dir="rtl" title={t('projectsTitle', 'ar')} description="المشاريع وأعمال المصادر المفتوحة لمحمد سمير الصوالحي">
  <div class="shell">
    <header class="page-head">
      <h1>{t('projectsTitle', 'ar')}</h1>
      <p>أشياء بنيتها، من أدوات اللغة إلى خرائط تعمل في الإنتاج.</p>
    </header>

    <section class="section" style="padding-top:24px">
      {projects.map((project) => (
        <article class="frame" data-title={project.title}>
          <a href={project.link} target="_blank" rel="noopener noreferrer" tabindex="-1" style="display:block"><img src={project.image} alt={project.title} loading="lazy" class="thumb" /></a>
          {project.period && (
            <p class="faint mono" style="font-size:.75rem;margin-top:12px">{project.period}</p>
          )}
          <p class="muted" style="margin-top:8px">{project.description}</p>
          {project.story && (
            <p style="margin-top:12px">{project.story}</p>
          )}
          {project.future_note && (
            <p class="faint" style="margin-top:12px">{project.future_note}</p>
          )}
          <div class="tags">
            {project.tech.split(',').map((tech) => (
              <span>{tech.trim()}</span>
            ))}
          </div>
          <p style="margin-top:12px">
            <a href={project.link} class="link mono" target="_blank" rel="noopener noreferrer">{t('learnMore', 'ar')}</a>
          </p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px dashed var(--line);
  }
</style>
