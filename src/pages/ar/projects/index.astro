---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import projectsData from '../../../data/ar/projects.js';

const { projects } = projectsData;
---

<BaseLayout lang="ar" dir="rtl" title={t('projectsTitle', 'ar')} description="المشاريع وأعمال المصادر المفتوحة لمحمد سمير الصوالحي">
  <div class="page-container">
    <h1 class="page-title">{t('projectsTitle', 'ar')}</h1>

    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card">
          <div class="card-image-wrap">
            <div class="image-overlay"></div>
            <img src={project.image} alt={project.title} class="card-img" />
            <div class="img-gradient"></div>

            <div class="card-content">
              <h3 class="card-title">{project.title}</h3>
              <div class="tech-tags">
                {project.tech.split(',').map((tech) => (
                  <span class="tech-tag">{tech.trim()}</span>
                ))}
              </div>
              <p class="card-desc">{project.description}</p>
              <a href={project.link} class="learn-more" target="_blank">
                {t('learnMore', 'ar')}
                <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: #262626;
  }

  :global(.dark) .page-title {
    color: #f5f5f5;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: #ffffff;
    border: 1px solid #d4d4d4;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .project-card {
    background-color: #1a1a1a;
    border-color: #404040;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    border-color: rgba(2, 132, 199, 0.5);
  }

  :global(.dark) .project-card:hover {
    border-color: rgba(14, 165, 233, 0.5);
  }

  .card-image-wrap {
    position: relative;
    padding-bottom: 56.25%;
    overflow: hidden;
  }

  .card-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    filter: saturate(1.1) contrast(1.1);
  }

  .project-card:hover .card-img {
    transform: scale(1.1);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.2), rgba(2, 132, 199, 0.2));
    z-index: 10;
  }

  :global(.dark) .image-overlay {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(14, 165, 233, 0.2));
  }

  .img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.5), transparent);
    opacity: 0.6;
    z-index: 20;
  }

  .card-content {
    position: absolute;
    inset: 0;
    z-index: 30;
    padding: 1rem;
    padding-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transform: translateY(0);
    transition: transform 0.5s ease;
  }

  .project-card:hover .card-content {
    transform: translateY(-20px);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.375rem;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.375rem;
  }

  .tech-tag {
    padding: 0.125rem 0.5rem;
    background-color: rgba(64, 64, 64, 0.3);
    backdrop-filter: blur(4px);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #ffffff;
  }

  .card-desc {
    display: none;
    font-size: 0.875rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .card-desc {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
    }
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background-color: rgba(2, 132, 199, 0.9);
    backdrop-filter: blur(4px);
    color: #262626;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    width: fit-content;
    opacity: 0;
    text-decoration: none;
  }

  :global(.dark) .learn-more {
    background-color: rgba(14, 165, 233, 0.9);
    color: #ffffff;
  }

  .learn-more:hover {
    background-color: #0284c7;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  :global(.dark) .learn-more:hover {
    background-color: #0ea5e9;
  }

  .project-card:hover .learn-more {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .learn-more {
      opacity: 1;
    }
    .project-card:hover {
      transform: none;
    }
    .project-card:hover .card-content {
      transform: translateY(-10px);
    }
  }

  .arrow-icon {
    height: 0.875rem;
    width: 0.875rem;
    transition: transform 0.2s ease;
  }

  .learn-more:hover .arrow-icon {
    transform: translateX(-4px);
  }
</style>
