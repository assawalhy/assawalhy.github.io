---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import authorData from '../../../data/ar/author.js';
import ContactForm from '../../../components/ContactForm.astro';

const { author } = authorData;
---

<BaseLayout lang="ar" dir="rtl" title={t('startConversation', 'ar')} description="تواصل مع محمد سمير الصوالحي">
  <div class="shell">
    <header class="page-head">
      <h1>{t('startConversation', 'ar')}</h1>
      <p>البريد هو الأفضل. النموذج أدناه يصل إلى البريد نفسه.</p>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="frame" data-title="روابط">
        <p class="muted">{author.description}</p>
        <ul class="rows" style="margin-top:12px">
          <li>
            <span class="rows__key">البريد الإلكتروني</span>
            <div>
              <a href={`mailto:${author.email}`} class="link"><span dir="ltr">{author.email}</span></a>
            </div>
          </li>
          <li>
            <span class="rows__key">لينكد إن</span>
            <div>
              <a href={author.linkedin} class="link" target="_blank" rel="noopener noreferrer"><span dir="ltr">in/{author.linkedin.split('/').pop()}</span></a>
            </div>
          </li>
          <li>
            <span class="rows__key">جيت هب</span>
            <div>
              <a href={author.github} class="link" target="_blank" rel="noopener noreferrer"><span dir="ltr">{author.github.replace('https://github.com/', '')}</span></a>
            </div>
          </li>
          <li>
            <span class="rows__key">إكس</span>
            <div>
              <a href={author.x} class="link" target="_blank" rel="noopener noreferrer"><span dir="ltr">@{author.x.split('/').pop()}</span></a>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="talk">
      <ContactForm lang="ar" email={author.email} />
    </section>
  </div>
</BaseLayout>
