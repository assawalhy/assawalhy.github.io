---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import seminarsData from '../../../data/ar/seminars.js';

const { seminars } = seminarsData;
---

<BaseLayout lang="ar" dir="rtl" title={t('seminarsTitle', 'ar')} description="اللقاءات والندوات لمحمد سمير الصوالحي">
  <div class="page-container">
    <h1 class="page-title">{t('seminarsTitle', 'ar')}</h1>

    <div class="seminars-grid">
      {seminars.map((seminar) => (
        <a href={seminar.link} target="_blank" class="seminar-link">
          <div class="seminar-card">
            <div class="card-image-wrap">
              <img src={seminar.image} alt={seminar.title} class="card-img" />
            </div>
            <div class="card-body">
              <p class="card-date">
                <span class="date-inner">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {seminar.date}
                </span>
              </p>
              <h3 class="card-title">{seminar.title}</h3>
              <p class="card-summary">{seminar.summary}</p>
              <span class="platform-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                  <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                  <line x1="6" y1="1" x2="6" y2="4"/>
                  <line x1="10" y1="1" x2="10" y2="4"/>
                  <line x1="14" y1="1" x2="14" y2="4"/>
                </svg>
                {seminar.platform}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                  <path d="M7 17l9.2-9.2M17 17V7H7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: #262626;
  }

  :global(.dark) .page-title {
    color: #f5f5f5;
  }

  .seminars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .seminar-link {
    display: block;
    text-decoration: none;
  }

  .seminar-card {
    overflow: hidden;
    border-radius: 0.5rem;
    background-color: #ffffff;
    border: 1px solid #d4d4d4;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  :global(.dark) .seminar-card {
    background-color: #1a1a1a;
    border-color: #404040;
  }

  .seminar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.15);
    border-color: rgba(2, 132, 199, 0.5);
  }

  :global(.dark) .seminar-card:hover {
    border-color: rgba(14, 165, 233, 0.5);
  }

  .card-image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .seminar-card:hover .card-img {
    transform: scale(1.1);
  }

  .card-body {
    padding: 1.25rem 1.5rem;
  }

  @media (max-width: 639px) {
    .card-body {
      padding: 1rem 1.25rem;
    }
  }

  .card-date {
    color: #525252;
    font-size: 0.875rem;
    margin-bottom: 0.375rem;
  }

  :global(.dark) .card-date {
    color: #a3a3a3;
  }

  .date-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #262626;
    transition: color 0.2s ease;
  }

  :global(.dark) .card-title {
    color: #f5f5f5;
  }

  .seminar-link:hover .card-title {
    color: #0284c7;
  }

  :global(.dark) .seminar-link:hover .card-title {
    color: #0ea5e9;
  }

  .card-summary {
    color: #525252;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.dark) .card-summary {
    color: #a3a3a3;
  }

  .platform-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #0284c7;
  }

  :global(.dark) .platform-badge {
    color: #0ea5e9;
  }

  .external-icon {
    opacity: 0;
    transition: all 0.2s ease;
    margin-right: -0.25rem;
  }

  .seminar-link:hover .external-icon {
    opacity: 1;
    margin-right: 0;
  }

  @media (max-width: 639px) {
    .seminar-card:hover {
      transform: none;
    }
  }
</style>
