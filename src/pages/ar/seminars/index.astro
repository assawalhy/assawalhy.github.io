---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import seminarsData from '../../../data/ar/seminars.js';

const { seminars } = seminarsData;
---

<BaseLayout lang="ar" dir="rtl" title={t('seminarsTitle', 'ar')} description="اللقاءات والندوات لمحمد سمير الصوالحي">
  <div class="shell">
    <header class="page-head">
      <h1>{t('seminarsTitle', 'ar')}</h1>
      <p>لقاءات وجلسات مجتمعية شاركت فيها أو قدمتها.</p>
    </header>

    <section class="section" style="padding-top:24px">
      {seminars.map((seminar) => (
        <article class="frame" data-title={seminar.platform}>
          {seminar.image && (
            <img src={seminar.image} alt={seminar.title} loading="lazy" class="thumb" />
          )}
          <p class="faint mono" style="font-size:.75rem;margin-top:12px">{seminar.date}</p>
          <h2>
            <a href={seminar.link} class="link" target="_blank" rel="noopener noreferrer">{seminar.title}</a>
          </h2>
          <p class="muted" style="margin-top:8px">{seminar.summary}</p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px dashed var(--line);
  }

  h2 {
    font-size: 1rem;
    font-weight: 500;
    text-transform: none;
    margin-top: 12px;
  }
</style>
