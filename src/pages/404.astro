---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'en';
const dir = 'ltr';
---

<BaseLayout lang={lang} dir={dir} title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="shell">
    <section class="section" style="padding-top:96px">
      <div class="frame" data-title="404">
        <p class="mono">GET {"<this page>"} → 404 not found</p>
        <p class="muted" style="margin-top:8px">The page you're looking for doesn't exist.</p>
        <p style="margin-top:20px"><a href="/en/" class="btn">Go Home</a></p>
      </div>
    </section>
  </div>
</BaseLayout>
