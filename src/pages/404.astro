---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'en';
const dir = 'ltr';
---

<BaseLayout lang={lang} dir={dir} title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-4 text-center">
    <h1 class="text-6xl font-bold text-[#171717] dark:text-[#fafafa] mb-4 font-display">404</h1>
    <p class="text-xl text-[#525252] dark:text-[#a3a3a3] mb-8 max-w-md">
      The page you're looking for doesn't exist.
    </p>
    <a href="/en/" class="inline-flex items-center gap-2 px-6 py-3 rounded-md border border-[#d4d4d4] dark:border-[#404040] text-[#262626] dark:text-[#f5f5f5] hover:border-[#0284c7] dark:hover:border-[#0ea5e9] hover:text-[#0284c7] dark:hover:text-[#0ea5e9] transition-all duration-300 font-semibold">
      Go Home
    </a>
  </div>
</BaseLayout>
