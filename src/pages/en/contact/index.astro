---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import authorData from '../../../data/en/author.js';
import ContactForm from '../../../components/ContactForm.astro';

const { author } = authorData;
---

<BaseLayout lang="en" dir="ltr" title={t('startConversation', 'en')} description="Get in touch with Muhammad Samir Assawalhy">
  <div class="shell">
    <header class="page-head">
      <h1>{t('startConversation', 'en')}</h1>
      <p>Email works best. The form below goes to the same inbox.</p>
      <p class="faint mono">{author.name}</p>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="frame" data-title="links">
        <p class="muted">{author.description}</p>
        <ul class="rows">
          <li>
            <div class="rows__key">email</div>
            <div><a href={`mailto:${author.email}`} class="link">{author.email}</a></div>
          </li>
          <li>
            <div class="rows__key">linkedin</div>
            <div><a href={author.linkedin} class="link" target="_blank" rel="noopener noreferrer">in/{author.linkedin.split('/').pop()}</a></div>
          </li>
          <li>
            <div class="rows__key">github</div>
            <div><a href={author.github} class="link" target="_blank" rel="noopener noreferrer">{author.github.replace('https://github.com/', '')}</a></div>
          </li>
          <li>
            <div class="rows__key">x</div>
            <div><a href={author.x} class="link" target="_blank" rel="noopener noreferrer">@{author.x.split('/').pop()}</a></div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="talk">
      <ContactForm lang="en" email={author.email} />
    </section>
  </div>
</BaseLayout>
