---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import authorData from '../../../data/en/author.js';

const { author } = authorData;
---

<BaseLayout lang="en" dir="ltr" title={t('startConversation', 'en')} description="Get in touch with Muhammad Samir Assawalhy">
  <div class="page-container">
    <h1 class="page-title">{t('startConversation', 'en')}</h1>

    <div class="card">
      <div class="card-inner">
        <p class="intro-text">{author.description}</p>

        <div class="links-section">
          <div class="links-grid">
            <a href={`mailto:${author.email}`} class="contact-link">
              <svg class="link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <div class="link-text">
                <div class="link-label">Email</div>
                <div class="link-value">{author.email}</div>
              </div>
            </a>

            <a href={author.linkedin} target="_blank" class="contact-link">
              <svg class="link-icon" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.47 2H3.53a1.45 1.45 0 0 0-1.47 1.43v17.14A1.45 1.45 0 0 0 3.53 22h16.94a1.45 1.45 0 0 0 1.47-1.43V3.43A1.45 1.45 0 0 0 20.47 2ZM8.09 18.74h-3v-9h3ZM6.59 8.48a1.56 1.56 0 1 1 0-3.12a1.57 1.57 0 1 1 0 3.12Zm12.32 10.26h-3v-4.83c0-1.21-.43-2-1.52-2A1.65 1.65 0 0 0 12.85 13a2 2 0 0 0-.1.73v5h-3v-9h3V11a3 3 0 0 1 2.71-1.5c2 0 3.45 1.29 3.45 4.06Z"/>
              </svg>
              <div class="link-text">
                <div class="link-label">LinkedIn</div>
                <div class="link-value">in/{author.linkedin.split('/').pop()}</div>
              </div>
            </a>

            <a href={author.github} target="_blank" class="contact-link">
              <svg class="link-icon" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12 24 5.37 18.63 0 12 0Z"/>
              </svg>
              <div class="link-text">
                <div class="link-label">GitHub</div>
                <div class="link-value">{author.github.replace('https://github.com/', '')}</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="toaster" class="toaster"></div>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(function() {
        showToaster('Email copied to clipboard!');
      }, function(err) {
        showToaster('Failed to copy.');
        console.error('Could not copy text: ', err);
      });
    }

    function showToaster(message) {
      var toaster = document.getElementById('toaster');
      toaster.textContent = message;
      toaster.classList.add('show');
      setTimeout(function() {
        toaster.classList.remove('show');
      }, 3000);
    }
  </script>
</BaseLayout>

<style>
  .page-container {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    word-break: break-word;
    color: #262626;
  }

  :global(.dark) .page-title {
    color: #f5f5f5;
  }

  .card {
    background-color: #ffffff;
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    padding: 1rem;
    min-width: 0;
  }

  :global(.dark) .card {
    background-color: #1a1a1a;
    border-color: #404040;
  }

  @media (min-width: 640px) {
    .card { padding: 1.5rem; }
  }

  @media (min-width: 768px) {
    .card { padding: 2rem; }
  }

  .card-inner {
    max-width: 100%;
  }

  .intro-text {
    color: #525252;
    font-size: 1.125rem;
    margin-bottom: 2rem;
    line-height: 1.75;
  }

  :global(.dark) .intro-text {
    color: #a3a3a3;
  }

  .links-section {
    border: 1px solid #d4d4d4;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }

  :global(.dark) .links-section {
    border-color: #404040;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background-color: #ffffff;
    border: 1px solid #d4d4d4;
    transition: all 0.3s ease;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  :global(.dark) .contact-link {
    background-color: #1a1a1a;
    border-color: #404040;
  }

  .contact-link:hover {
    border-color: #a3a3a3;
    transform: translateY(-2px);
  }

  :global(.dark) .contact-link:hover {
    border-color: #737373;
  }

  .link-icon {
    width: 1.75rem;
    height: 1.75rem;
    color: #525252;
    flex-shrink: 0;
  }

  :global(.dark) .link-icon {
    color: #a3a3a3;
  }

  .link-text {
    min-width: 0;
  }

  .link-label {
    color: #525252;
    transition: color 0.3s ease;
  }

  :global(.dark) .link-label {
    color: #a3a3a3;
  }

  .contact-link:hover .link-label {
    color: #262626;
  }

  :global(.dark) .contact-link:hover .link-label {
    color: #f5f5f5;
  }

  .link-value {
    font-size: 0.875rem;
    color: #737373;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.dark) .link-value {
    color: #808080;
  }

  @media (max-width: 768px) {
    .contact-link {
      width: 100%;
    }
  }

  .toaster {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #333;
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 5px;
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
  }

  :global(.dark) .toaster {
    background-color: #e5e7eb;
    color: #1f2937;
  }

  .toaster.show {
    opacity: 1;
  }
</style>
