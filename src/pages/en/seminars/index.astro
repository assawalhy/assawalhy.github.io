---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import seminarsData from '../../../data/en/seminars.js';

const { seminars } = seminarsData;
---

<BaseLayout lang="en" dir="ltr" title={t('seminarsTitle', 'en')} description="Seminars and talks by Muhammad Samir Assawalhy">
  <div class="shell">
    <header class="page-head">
      <h1>{t('seminarsTitle', 'en')}</h1>
      <p>Talks and community sessions I joined or gave.</p>
    </header>

    <section class="section" style="padding-top:24px">
      {seminars.map((seminar) => (
        <article class="frame" data-title={seminar.platform}>
          {seminar.image && <img src={seminar.image} alt={seminar.title} loading="lazy" class="thumb" />}
          <p class="faint mono" style="font-size:.75rem;margin-top:12px">{seminar.date}</p>
          <h2 class="seminar-title">
            <a href={seminar.link} class="link" target="_blank" rel="noopener noreferrer">{seminar.title}</a>
          </h2>
          <p class="muted" style="margin-top:8px">{seminar.summary}</p>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px dashed var(--line);
    filter: grayscale(0.3);
  }

  .seminar-title {
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 500;
    text-transform: none;
  }
</style>
