---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import blogsData from '../../../data/en/blogs.js';
import type { Lang } from '../../../i18n';

const lang: Lang = 'en';
const dir = 'ltr';
const title = 'Blog';
const description = 'Articles and write-ups by Muhammad Samir Assawalhy';
const { blogs } = blogsData;
---

<BaseLayout {lang} {dir} {title} {description}>
  <div class="shell">
    <header class="page-head">
      <h1>{title}</h1>
      <p>Notes on contests, tools and what I learned building them.</p>
    </header>

    <section class="section" style="padding-top:24px">
      <div class="frame" data-title="posts">
        {blogs.length === 0 && (
          <p class="muted">No posts here yet. I am still shaping the next write-up.</p>
        )}
        <ul class="rows">
          {blogs.map((entry) => (
            <li>
              <div class="rows__key">{entry.date}</div>
              <div>
                <h3><a href={entry.link} class="link" target="_blank" rel="noopener noreferrer">{entry.title}</a></h3>
                <p>{entry.summary}</p>
                {entry.tags && entry.tags.length > 0 && (
                  <div class="tags">
                    {entry.tags.filter((t) => t).map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
