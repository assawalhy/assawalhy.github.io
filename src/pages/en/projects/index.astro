---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import projectsData from '../../../data/en/projects.js';

const { projects } = projectsData;
---

<BaseLayout lang="en" dir="ltr" title={t('projectsTitle', 'en')} description="Projects and open source work by Muhammad Samir Assawalhy">
  <div class="shell">
    <header class="page-head">
      <h1>{t('projectsTitle', 'en')}</h1>
      <p>Things I built, from language tooling to production maps.</p>
    </header>

    <section class="section" style="padding-top:24px">
      {projects.map((project) => (
        <article class="frame" data-title={project.title}>
          <a href={project.link} target="_blank" rel="noopener noreferrer" tabindex="-1" style="display:block"><img src={project.image} alt={project.title} loading="lazy" class="thumb" /></a>
          {project.period && (
            <p class="faint mono" style="font-size:.75rem;margin-top:12px">{project.period}</p>
          )}
          <p class="muted" style="margin-top:8px">{project.description}</p>
          {project.story && <p>{project.story}</p>}
          {project.future_note && <p class="faint">{project.future_note}</p>}
          <div class="tags">
            {project.tech.split(',').map((tech) => (
              <span>{tech.trim()}</span>
            ))}
          </div>
          <a class="link mono" href={project.link} target="_blank" rel="noopener noreferrer">{t('learnMore', 'en')}</a>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px dashed var(--line);
    filter: grayscale(0.3);
  }
</style>
